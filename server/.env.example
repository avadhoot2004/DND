# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB connection string with replica set support)
MONGODB_URI=mongodb://127.0.0.1:27017/dnd_gaming_hub?replicaSet=rs0

# Session Secret (Generate a strong random string in production)
SESSION_SECRET=dev_session_secret_change_in_production_min32chars

# Timezone (Default: Asia/Kolkata)
TZ=Asia/Kolkata
